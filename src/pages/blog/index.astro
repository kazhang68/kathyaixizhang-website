---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---
<Layout title="Journal" active="blog">
  <section class="page-intro"><div class="section-label"><span class="mint">~/</span> POSTS</div><h1>Journal</h1><p>Technical notes, project updates, and personal posts.</p></section>
  <section class="blog-list" aria-label="Journal entries">
    <div class="blog-toolbar"><div class="filter-list" role="group" aria-label="Filter posts by topic"><button class="filter-button selected" data-filter="all" aria-pressed="true">All entries <span>{posts.length}</span></button>{tags.map((tag) => <button class="filter-button" data-filter={tag} aria-pressed="false">{tag}</button>)}</div></div>
    <div class:list={["posts-grid", { "single-post": posts.length === 1 }]}>{posts.map((post, index) => <div class="filter-post" data-tags={JSON.stringify(post.data.tags)}><PostCard post={post} index={index} /></div>)}</div>
    {!posts.length && <p class="empty-state">No posts published yet.</p>}
  </section>
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-tags]");
  buttons.forEach((button) => button.addEventListener("click", () => {
    const filter = button.dataset.filter;
    buttons.forEach((item) => {
      const selected = item === button;
      item.classList.toggle("selected", selected);
      item.setAttribute("aria-pressed", String(selected));
    });
    cards.forEach((card) => {
      const tags: string[] = JSON.parse(card.dataset.tags || "[]");
      card.hidden = filter !== "all" && !tags.includes(filter || "");
    });
  }));
</script>
