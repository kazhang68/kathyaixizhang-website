---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PixelName from "../components/PixelName.astro";
import PostCard from "../components/PostCard.astro";
import AsciiArt from "../components/AsciiArt.astro";
import { pathTo, site } from "../lib/site";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<Layout>
  <section class="hero" aria-labelledby="hero-title">
    <h1 class="sr-only" id="hero-title">Kathy Zhang. Software Engineer II at Microsoft.</h1>
    <PixelName />
    <div class="rainbow-rule"></div>
    <div class="hero-bottom">
      <div><p class="hero-heading">Software Engineer II<br /><span class="mint">at Microsoft.</span></p><p class="hero-description">I work on <span class="term-cyan">data infrastructure</span>, <span class="term-purple">developer tooling</span>, and <span class="term-pink">AI agents</span>.</p><div class="hero-actions"><a class="button button-light" href="#work">View experience <span aria-hidden="true">-&gt;</span></a><a class="text-link" href="#about">About <span aria-hidden="true">-&gt;</span></a></div></div>
      <aside class="profile-card" aria-label="Profile summary">
        <dl>
          <div><dt>Current role</dt><dd>Software Engineer II, Microsoft<br /><span class="muted">April 2021 &ndash; present</span></dd></div>
          <div><dt>Education</dt><dd>Computer Science, Cornell University<br /><span class="muted">Bachelor's degree, 2020</span></dd></div>
          <div><dt>Personal projects</dt><dd>Self-hosted homelab &amp; backup infrastructure</dd></div>
        </dl>
      </aside>
    </div>
    <div class="hero-footnote"><a href="#about">ABOUT <span aria-hidden="true">&#8595;</span></a></div>
  </section>

  <section class="section about-section" id="about" aria-labelledby="about-title">
    <div class="section-label"><span class="mint">01 /</span> BACKGROUND</div>
    <div class="about-grid">
      <h2 id="about-title">About</h2>
      <div class="about-copy"><p>I'm a Software Engineer II at <span class="term-cyan">Microsoft</span>. My work includes <span class="term-cyan">Azure</span> data pipelines, <span class="term-yellow">SQL</span> query-generation systems, developer tooling, and <span class="term-pink">AI agents</span>.</p><p>I graduated from <span class="term-purple">Cornell University</span> with a bachelor's degree in Computer Science in 2020.</p><p>Outside of work, I maintain a <span class="term-green">homelab</span> with Unraid and Ubuntu servers, containerized applications, and a dedicated backup server.</p></div>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="section-label"><span class="mint">02 /</span> EXPERIENCE &amp; PROJECTS</div>
    <div class="section-heading"><h2 id="work-title">Work</h2><a class="text-link" href={site.resume} target="_blank" rel="noopener noreferrer">Full resume <span aria-hidden="true">&#8599;</span></a></div>
    <div class="work-list">
      <article class="work-row"><div class="work-company"><AsciiArt kind="window" compact /><div><h3>Microsoft</h3><span>Apr 2021 &mdash; present</span></div></div><div class="work-detail"><h3>Software Engineer II</h3><p>Developing <span class="term-cyan">Azure</span> data pipelines, <span class="term-yellow">SQL</span> query-generation tools, and <span class="term-pink">GitHub Copilot</span> agents. Responsibilities include production reliability and automated network isolation.</p><div class="work-tags"><span>Azure &amp; data infrastructure</span><span>Developer tooling</span><span>AI agents</span></div></div><span class="work-number">01</span></article>
      <article class="work-row"><div class="work-company"><AsciiArt kind="code" compact /><div><h3>Meta</h3><span>Jun &mdash; Aug 2020</span></div></div><div class="work-detail"><h3>Software Engineer Intern</h3><p>Built a web application to compare image-recognition models and visualize their product recommendations for marketplace data.</p><div class="work-tags"><span>React</span><span>Hack</span><span>Model evaluation</span></div></div><span class="work-number">02</span></article>
      <article class="work-row"><div class="work-company"><AsciiArt kind="server" compact /><div><h3>Homelab</h3><span>Personal project</span></div></div><div class="work-detail"><h3>Self-hosted infrastructure</h3><p>Self-hosted applications on <span class="term-green">Unraid and Ubuntu</span>, containerized services, reverse proxies, and a dedicated backup server with SnapRAID and mergerfs.</p><div class="work-tags"><span>Linux</span><span>Docker</span><span>Networking &amp; storage</span></div></div><span class="work-number">03</span></article>
    </div>
  </section>

  <section class="section journal-section" aria-labelledby="journal-title">
    <div class="section-label"><span class="mint">03 /</span> RECENT POSTS</div>
    <div class="section-heading"><h2 id="journal-title">Journal</h2><a class="text-link" href={pathTo("blog/")}>All entries <span aria-hidden="true">&#8594;</span></a></div>
    {posts.length ? <div class:list={["posts-grid", { "single-post": posts.length === 1 }]}>{posts.map((post, index) => <PostCard post={post} index={index} />)}</div> : <p class="empty-state">No posts published yet.</p>}
  </section>

  <section class="contact-section" aria-labelledby="contact-title"><div><div class="section-label"><span class="mint">04 /</span> EMAIL &amp; LINKS</div><h2 id="contact-title">Contact</h2><a class="contact-email" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">&#8599;</span></a></div></section>
</Layout>
