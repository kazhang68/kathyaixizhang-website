---
const glyphs = [
  ["10001", "10010", "10100", "11000", "10100", "10010", "10001"],
  ["01110", "11011", "11011", "11111", "11011", "11011", "11011"],
  ["11111", "00100", "00100", "00100", "00100", "00100", "00100"],
  ["11011", "11011", "11011", "11111", "11011", "11011", "11011"],
  ["11011", "11011", "11011", "01110", "00100", "00100", "00100"],
];
const decodeDuration = 560;
const matrix = glyphs.flatMap((glyph, letter) =>
  glyph.flatMap((row, y) =>
    [...row].map((value, x) => {
      const column = letter * 6 + x;
      return {
        x: column * 22,
        y: y * 22,
        column,
        active: value === "1",
        delay: column * 65 + (column * 17 + y * 31) % 120,
        symbol: ["0", "1", "/", "_", "{", "}"][(column * 7 + y * 13) % 6],
      };
    }),
  ),
);
const cells = matrix.filter(({ active }) => active);
const renderDuration = Math.max(...matrix.map(({ delay }) => delay)) + decodeDuration + 180;
const colors = ["#00b8ff", "#00d9ff", "#00efad", "#b5ef00", "#ffe600", "#ffb800", "#ff863d", "#e34ee6", "#aa43ff", "#d92aff", "#ff168f"];
const cellStyle = ({ x, y, delay, column }: typeof matrix[number]) =>
  `left:${x / 706 * 100}%;top:${y / 195 * 100}%;--delay:${delay}ms;color:${colors[Math.floor(column / 29 * colors.length)]}`;
---
<div class="pixel-art" style={`--decode-duration: ${decodeDuration}ms; --render-duration: ${renderDuration}ms`}>
  <pre class="pixel-name" aria-hidden="true">{cells.map((cell) => <span class="pixel-cell" style={cellStyle(cell)}>{cell.y < 66 ? "██" : cell.y < 110 ? "▓▓" : "▒▒"}</span>)}{cells.filter(({ y }) => y === 132).map((cell) => <span class="pixel-echo" style={cellStyle({ ...cell, y: cell.y + 22 })}>░░</span>)}{matrix.map((cell) => <span class="pixel-noise" style={cellStyle(cell)}>{cell.symbol}</span>)}<span class="pixel-scan"></span><span class="pixel-caret">|</span></pre>
  <div class="pixel-caption"><span>Kathy Zhang</span><span>Software Engineer</span></div>
</div>
